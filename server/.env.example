# Example environment variables for the server (copy to .env and fill in values)
PORT=5000
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/resume-roaster
ANTHROPIC_API_KEY=sk-ant-...
# Set to "true" to skip real LLM calls and return mock data
LLM_MOCK=false
# Comma-separated allowed origins for CORS
CLIENT_ORIGIN=http://localhost:5173
